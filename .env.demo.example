# =============================================================================
# ChargeOps — CẤU HÌNH MÔI TRƯỜNG DEMO (.env.demo.example)
# =============================================================================
# File này là TEMPLATE mẫu (chỉ chứa placeholder, KHÔNG chứa secret thật).
# Demo: copy thành .env và điền secret thật. Spring Boot và launcher đều đọc .env.
# .env.demo chỉ được dùng khi truyền --env-file .env.demo cho Docker Compose.
# Dùng .env.example cho setup local. Giá trị không cần dấu nháy để Spring/Compose đọc giống nhau.
# =============================================================================

# 1. Profile Spring Boot (dev: bật Swagger, in log chi tiết)
SPRING_PROFILES_ACTIVE=dev

# Elasticsearch is off by default in the low-memory demo stack. Enable the Compose `search` profile to use it.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_REINDEX_ON_STARTUP=false

# Dify FAQ app API (server-side only)
DIFY_ENABLED=false
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_CONNECT_TIMEOUT_SECONDS=5
DIFY_READ_TIMEOUT_SECONDS=60
DIFY_REQUESTS_PER_MINUTE=3
DIFY_REQUESTS_PER_DAY=10
DIFY_TOTAL_REQUESTS_PER_DAY=30

# 2. Database PostgreSQL + PostGIS
POSTGRES_USER=chargeops
POSTGRES_PASSWORD=chargeops
POSTGRES_DB=chargeops
DATABASE_URL=jdbc:postgresql://localhost:5432/chargeops
REDIS_HOST=localhost
REDIS_PORT=6379

# 3. Keycloak IAM & Admin Service Account
KC_DB_NAME=keycloak
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_REALM=chargeops
KEYCLOAK_ADMIN_CLIENT_ID=chargeops-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=your_keycloak_admin_client_secret_here
KEYCLOAK_PUBLIC_URL=https://auth.chargeops.online
KEYCLOAK_ISSUER_URI=https://auth.chargeops.online/realms/chargeops
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/chargeops/protocol/openid-connect/certs
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080

# Grafana OAuth: client confidential và role được tạo trong Keycloak.
GRAFANA_OAUTH_CLIENT_ID=chargeops-observability
GRAFANA_OAUTH_CLIENT_SECRET=your_grafana_oauth_client_secret_here
GRAFANA_ROOT_URL=https://grafana.chargeops.online/
GRAFANA_COOKIE_SECURE=true
GATEWAY_PORT=8088

# 4. Cloudflare Tunnel public URLs
PUBLIC_ORIGIN=https://chargeops.online
CONSOLE_PUBLIC_URL=https://console.chargeops.online
API_PUBLIC_URL=https://api.chargeops.online
AUTH_PUBLIC_URL=https://auth.chargeops.online
DRIVER_PUBLIC_URL=https://driver.chargeops.online
BACKEND_BASE_URL=https://api.chargeops.online
FRONTEND_BASE_URL=https://console.chargeops.online
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173,http://localhost:8082,https://chargeops.online,https://console.chargeops.online,https://driver.chargeops.online

# 5. ImageKit SaaS Storage (Lưu trữ ảnh trạm sạc, avatar)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/chargeops

# 6. Payment Webhook (SePay)
# Webhook công khai: https://api.chargeops.online/api/v1/webhooks/sepay
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_here

# SePay sandbox: bật sau khi điền các giá trị thật từ môi trường test.
SEPAY_TEST_MODE_ENABLED=false
SEPAY_TEST_API_TOKEN=
SEPAY_TEST_BANK_ACCOUNT_XID=
SEPAY_TEST_ACCOUNT_NUMBER=
SEPAY_TEST_VA_PREFIX=
SEPAY_TEST_WEBHOOK_SECRET=

# 7. (Tùy chọn) Cấu hình Email SMTP thật nếu không dùng Mailpit
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-email@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Optional: enable backend booking-email delivery via Hostinger (SMTP STARTTLS).
# Keep these values private in your local .env; never commit a mailbox password.
# HOSTINGER_SMTP_USERNAME=support@chargeops.online
# HOSTINGER_SMTP_PASSWORD=
# Then run start-domain-demo-hostinger-mail.bat after setting the password.
