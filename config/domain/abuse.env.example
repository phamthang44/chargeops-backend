# Values below are non-secret defaults. Supply secrets via the runtime environment.
ABUSE_MODE=OBSERVE
ABUSE_GATEWAY_DRY_RUN=on
ABUSE_HMAC_KEY=
ABUSE_TRUSTED_PROXIES=
ABUSE_KEYCLOAK_METRICS_ENABLED=false
# Set exact gateway socket-peer CIDR(s) observed at this backend, never 0.0.0.0/0.
# ENFORCE requires a random HMAC key of at least 32 bytes.
