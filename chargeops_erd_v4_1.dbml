// =====================================================================
// ChargeOps ERD (dbdiagram.io) - Schema Version V54 (Updated for BKG-076)
// BKG-067: policy_chunks removed in target schema by guarded V60;
// legal_documents below matches V25/V26. This is a business presentation,
// not an exhaustive physical schema of all migrations through V60.
// =====================================================================
// Sơ đồ trình bày các bảng phục vụ nghiệp vụ hiện hành của ChargeOps;
// các bảng payout di sản (owner_payouts, owner_payout_items, payout_attempts,
// owner_adjustments) được giữ trong cơ sở dữ liệu để tương thích lịch sử
// và không thuộc phạm vi sơ đồ này.
//
// Phân chia theo 4 phân hệ nghiệp vụ chính + Nhóm phụ trợ/Audit:
// 1. Phân hệ 1: Người dùng, Trạm, Thiết bị và License
// 2. Phân hệ 2: Đặt chỗ, Lịch hoạt động và Biểu giá
// 3. Phân hệ 3: Thanh toán, Hoàn tiền và Quyết định trách nhiệm sự cố
// 4. Phân hệ 4: Hỗ trợ kỹ thuật (Support Ticket) và Khiếu nại
// 5. Phụ lục: Bảng Audit log, Lệnh idempotent, Sự cố thiết bị và Cấu hình hệ thống

// =====================================================================
// PHÂN HỆ 1: NGƯỜI DÙNG, TRẠM SẠC, THIẾT BỊ VÀ LICENSE
// =====================================================================

Table user_profile {
  id           uuid [pk, default: `gen_random_uuid()`, note: 'Khóa chính hồ sơ người dùng nội bộ']
  keycloak_id  varchar [unique, not null, note: 'Subject claim từ Keycloak JWT']
  email        varchar [not null, note: 'Email định danh người dùng']
  display_name varchar [note: 'Tên hiển thị']
  phone        varchar [note: 'Số điện thoại liên hệ']
  avatar_url   varchar [note: 'Đường dẫn ảnh đại diện']
  status       varchar [not null, default: 'ACTIVE', note: 'ACTIVE / SUSPENDED']
  created_at   timestamptz [not null, default: `now()`]
  updated_at   timestamptz [not null, default: `now()`]
  created_by   uuid
  updated_by   uuid
  deleted_at   timestamptz

  Indexes {
    email
    keycloak_id
  }
}

Table stations {
  id                 uuid [pk, default: `gen_random_uuid()`]
  owner_id           uuid [not null, note: 'Chủ sở hữu trạm sạc -> user_profile.id']
  name               varchar [not null, note: 'Tên trạm sạc']
  description        text
  address_line       varchar [not null, note: 'Địa chỉ chi tiết']
  ward_id            integer [note: 'Mã phường/xã hành chính']
  contact_phone      varchar
  latitude           "numeric(10,7)"
  longitude          "numeric(10,7)"
  location           geography [note: 'Tọa độ PostGIS phục vụ tìm kiếm bán kính']
  status             varchar [not null, note: 'PENDING_APPROVAL / APPROVED / REJECTED / SUSPENDED']
  operational_status varchar [not null, default: 'OPERATING', note: 'OPERATING / UNDER_MAINTENANCE / TEMPORARILY_CLOSED / PERMANENTLY_CLOSED']
  version            bigint [not null, default: 0, note: 'Khóa lạc quan']
  created_at         timestamptz [not null, default: `now()`]
  updated_at         timestamptz [not null, default: `now()`]
  created_by         uuid
  updated_by         uuid
  deleted_at         timestamptz

  Indexes {
    owner_id
    location [type: gist]
    status
    operational_status
  }
}

Table station_assets {
  id            uuid [pk, default: `gen_random_uuid()`]
  station_id    uuid [not null, note: 'FK -> stations.id']
  asset_type    varchar [not null, note: 'IMAGE / VIDEO / DOCUMENT / OTHER']
  asset_url     varchar [not null]
  storage_key   varchar
  alt_text      varchar
  display_order int [not null, default: 0]
  is_primary    boolean [not null, default: false]
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null, default: `now()`]
  created_by    uuid
  updated_by    uuid
  deleted_at    timestamptz

  Indexes {
    station_id
    (station_id, display_order)
  }
}

Table station_staff_assignments {
  id          uuid [pk, default: `gen_random_uuid()`]
  station_id  uuid [not null, note: 'FK -> stations.id']
  staff_id    uuid [not null, note: 'Nhân viên trạm -> user_profile.id']
  assigned_by uuid [not null, note: 'Người gán -> user_profile.id']
  status      varchar [not null, default: 'ACTIVE', note: 'ACTIVE / REVOKED']
  assigned_at timestamptz [not null, default: `now()`]
  revoked_at  timestamptz
  revoked_by  uuid [note: 'Người thu hồi quyền -> user_profile.id']
  note        varchar

  Indexes {
    station_id
    staff_id
    (station_id, staff_id)
  }
}

Table station_staff_invitations {
  id               uuid [pk, default: `gen_random_uuid()`]
  station_id       uuid [not null, note: 'FK -> stations.id']
  email            varchar(255) [not null, note: 'Email nhân viên được mời']
  identity_user_id varchar(255) [note: 'ID tài khoản nếu đã đăng ký']
  invited_by       uuid [not null, note: 'Chủ trạm mời -> user_profile.id']
  status           varchar(20) [not null, note: 'PENDING / SENT / ACCEPTED / CANCELLED']
  expires_at       timestamptz [not null]
  sent_at          timestamptz
  accepted_at      timestamptz
  cancelled_at     timestamptz
  created_at       timestamptz [not null, default: `now()`]
  updated_at       timestamptz [not null, default: `now()`]
  version          bigint [not null, default: 0]

  Indexes {
    station_id
    email
  }
}

Table charge_points {
  id                  uuid [pk, default: `gen_random_uuid()`]
  station_id          uuid [not null, note: 'FK -> stations.id']
  charge_point_code   varchar [not null, note: 'Mã trụ sạc (VD: CP-01)']
  name                varchar
  zone_label          varchar
  max_power_kw        numeric
  provisioning_status varchar [not null, note: 'UNCLAIMED / PROVISIONED / COMMISSIONED / DECOMMISSIONED']
  operational_status  varchar [not null, default: 'OPERATING', note: 'OPERATING / SUSPENDED / FAULTED / INACTIVE']
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null, default: `now()`]
  updated_at          timestamptz [not null, default: `now()`]
  created_by          uuid
  updated_by          uuid
  deleted_at          timestamptz

  Indexes {
    station_id
    charge_point_code
  }
}

Table connectors {
  id              uuid [pk, default: `gen_random_uuid()`]
  charge_point_id uuid [not null, note: 'FK -> charge_points.id']
  connector_code  varchar [not null, note: 'Mã súng sạc (VD: CN-01)']
  connector_type  varchar [not null, note: 'CCS2 / CHADEMO / TYPE2 / GBT']
  power_kw        numeric [not null]
  charger_type    varchar [not null, note: 'AC / DC']
  runtime_status  varchar [not null, default: 'AVAILABLE', note: 'AVAILABLE / OCCUPIED / CHARGING / FAULTED / UNAVAILABLE']
  version         bigint [not null, default: 0]
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]
  created_by      uuid
  updated_by      uuid
  deleted_at      timestamptz

  Indexes {
    charge_point_id
    runtime_status
  }
}

Table licenses {
  id                      uuid [pk, default: `gen_random_uuid()`]
  station_id              uuid [not null, note: 'FK -> stations.id']
  owner_id                uuid [not null, note: 'Chủ sở hữu hưởng license -> user_profile.id']
  renewed_from_license_id uuid [note: 'Truy vết gia hạn từ license trước']
  license_code            varchar(20) [unique, not null, note: 'Mã giấy phép duy nhất (VD: LIC-001000)']
  plan                    varchar [not null, note: 'MONTHLY / YEARLY']
  fee_amount              "numeric(15,2)" [not null]
  start_at                timestamptz [not null]
  expires_at              timestamptz [not null]
  status                  varchar [not null, note: 'PENDING / ACTIVE / EXPIRED / CANCELLED / SUSPENDED']
  version                 bigint [not null, default: 0]
  created_at              timestamptz [not null, default: `now()`]
  updated_at              timestamptz [not null, default: `now()`]
  created_by              uuid
  updated_by              uuid

  Indexes {
    station_id
    owner_id
    license_code
  }
}

// =====================================================================
// PHÂN HỆ 2: ĐẶT CHỖ, LỊCH HOẠT ĐỘNG VÀ BIỂU GIÁ
// =====================================================================

Table station_operating_schedules {
  id         uuid [pk, default: `gen_random_uuid()`]
  station_id uuid [not null, note: 'FK -> stations.id']
  is_24_7    boolean [not null, default: true]
  status     varchar [not null, default: 'ACTIVE', note: 'ACTIVE / INACTIVE']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    station_id
  }
}

Table station_operating_periods {
  id          uuid [pk, default: `gen_random_uuid()`]
  schedule_id uuid [not null, note: 'FK -> station_operating_schedules.id']
  day_of_week varchar [not null, note: 'MONDAY..SUNDAY']
  open_time   time [not null]
  close_time  time [not null]

  Indexes {
    schedule_id
    day_of_week
  }
}

Table station_booking_settings {
  id                       uuid [pk, default: `gen_random_uuid()`]
  station_id               uuid [unique, not null, note: 'FK -> stations.id']
  slot_duration_minutes    int [not null, default: 30]
  max_advance_booking_days int [not null, default: 7]
  min_cancel_lead_hours    int [not null, default: 1]
  penalty_rate_percent     "numeric(5,2)" [not null, default: 0.00]
  created_at               timestamptz [not null, default: `now()`]
  updated_at               timestamptz [not null, default: `now()`]
}

Table tou_rates {
  id             uuid [pk, default: `gen_random_uuid()`]
  station_id     uuid [note: 'NULL = mặc định toàn hệ thống; có giá trị = override theo trạm']
  name           varchar [not null]
  period_code    varchar [not null, note: 'NORMAL / PEAK / OFF_PEAK']
  start_time     time [not null]
  end_time       time [not null]
  price_per_kwh  "numeric(15,2)" [not null]
  effective_from timestamptz [not null]
  effective_to   timestamptz
  created_at     timestamptz [not null, default: `now()`]
  created_by     uuid

  Indexes {
    station_id
    (period_code, start_time, end_time)
  }
}

Table bookings {
  id                         uuid [pk, default: `gen_random_uuid()`]
  booking_code               varchar [unique, not null, note: 'Mã đơn đặt chỗ']
  driver_id                  uuid [not null, note: 'Tài xế đặt chỗ -> user_profile.id']
  connector_id               uuid [not null, note: 'Súng sạc giữ chỗ -> connectors.id']
  financial_owner_id         uuid [not null, note: 'Snapshot bất biến Chủ trạm hưởng doanh thu lúc đặt -> user_profile.id']
  start_at                   timestamptz [not null]
  end_at                     timestamptz [not null]
  status                     varchar [not null, default: 'PENDING', note: 'PENDING / CONFIRMED / CHECKED_IN / CHARGING / COMPLETED / EXPIRED / CANCELLED / NO_SHOW']
  total_amount               "numeric(15,2)" [not null]
  station_name_snapshot      varchar
  station_address_snapshot   varchar
  charge_point_code_snapshot varchar
  connector_code_snapshot    varchar
  expires_at                 timestamptz [note: 'Hạn chót thanh toán (hold10)']
  check_in_deadline          timestamptz [note: 'Hạn chót check-in (start + 15m)']
  checked_in_at              timestamptz
  cancelled_at               timestamptz
  created_at                 timestamptz [not null, default: `now()`]
  updated_at                 timestamptz [not null, default: `now()`]
  created_by                 uuid
  updated_by                 uuid

  Indexes {
    driver_id
    connector_id
    financial_owner_id
    status
    (connector_id, start_at, end_at)
  }
}

Table booking_price_lines {
  id            uuid [pk, default: `gen_random_uuid()`]
  booking_id    uuid [not null, note: 'FK -> bookings.id']
  segment_start timestamptz [not null]
  segment_end   timestamptz [not null]
  energy_kwh    "numeric(10,3)" [not null, note: 'Sản lượng ước tính theo khung giờ']
  rate_per_kwh  "numeric(15,2)" [not null, note: 'Đơn giá TOU áp dụng']
  amount        "numeric(15,2)" [not null, note: 'Thành tiền = energy_kwh * rate_per_kwh']
  created_at    timestamptz [not null, default: `now()`]

  Indexes {
    booking_id
  }
}

// =====================================================================
// PHÂN HỆ 3: THANH TOÁN, HOÀN TIỀN VÀ QUYẾT ĐỊNH TRÁCH NHIỆM
// =====================================================================

Table payments {
  id            uuid [pk, default: `gen_random_uuid()`]
  booking_id    uuid [unique, not null, note: 'Mỗi booking chỉ có 1 bản ghi payment gốc -> bookings.id']
  amount        "numeric(15,2)" [not null, note: 'Giá trị gói đặt chỗ']
  status        varchar [not null, default: 'PENDING', note: 'PENDING / PAID / FAILED / REFUNDED']
  environment   varchar [not null, default: 'SIMULATOR', note: 'SIMULATOR / TEST / LIVE']
  paid_at       timestamptz [note: 'Thời điểm thanh toán thành công']
  refund_amount "numeric(15,2)" [not null, default: 0.00, note: 'Tổng tiền đã hoàn thành công']
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null, default: `now()`]
  created_by    uuid
  updated_by    uuid

  Indexes {
    booking_id
    status
    environment
  }
}

Table payment_transactions {
  id             uuid [pk, default: `gen_random_uuid()`]
  payment_id     uuid [note: 'Liên kết payment gói -> payments.id']
  order_id       varchar [not null, note: 'Mã đơn thanh toán cổng ngân hàng / QR']
  amount         "numeric(15,2)" [not null]
  classification varchar [not null, note: 'APPLIED / UNAPPLIED / EXCLUDED / REFUNDED']
  provider       varchar [not null, default: 'SIMULATOR', note: 'SEPAY / VNPAY / SIMULATOR']
  provider_ref   varchar [note: 'Mã tham chiếu giao dịch cổng']
  paid_at        timestamptz [not null]
  created_at     timestamptz [not null, default: `now()`]

  Indexes {
    payment_id
    order_id
    classification
  }
}

Table refunds {
  id                    uuid [pk, default: `gen_random_uuid()`]
  booking_id            uuid [not null, note: 'FK -> bookings.id']
  payment_id            uuid [unique, not null, note: 'Mỗi payment tối đa 1 refund obligation -> payments.id']
  amount                "numeric(15,2)" [not null, note: 'Nghĩa vụ hoàn tiền']
  status                varchar [not null, default: 'PENDING', note: 'PENDING / SUCCEEDED / FAILED / CANCELLED']
  basis_type            varchar [not null, note: 'BOOKING_CANCELLATION / STATION_FAILURE_FINDING / SERVICE_FAILURE_DECISION']
  policy_type           varchar [not null, note: 'VOLUNTARY_GRACE / NO_SHOW / STATION_FAULT / ADMIN_DISCRETION']
  reason                text
  requires_owner_action boolean [not null, default: false, note: 'Cần Owner bấm retry thủ công sau khi attempt đầu thất bại']
  created_at            timestamptz [not null, default: `now()`]
  updated_at            timestamptz [not null, default: `now()`]

  Indexes {
    booking_id
    payment_id
    status
  }
}

Table refund_attempts {
  id                uuid [pk, default: `gen_random_uuid()`]
  refund_id         uuid [not null, note: 'FK -> refunds.id']
  attempt_sequence  int [not null, note: 'Lần thử thứ n']
  status            varchar [not null, note: 'STARTED / SUCCEEDED / FAILED']
  amount            "numeric(15,2)" [not null]
  execution_trigger varchar [not null, note: 'AUTO_FIRST_ATTEMPT / OWNER_MANUAL_RETRY / ADMIN']
  actor_id          uuid [note: 'Người thực hiện retry -> user_profile.id']
  created_at        timestamptz [not null, default: `now()`]

  Indexes {
    refund_id
    status
    execution_trigger
  }
}

Table refund_auto_dispatches {
  id            uuid [pk, default: `gen_random_uuid()`]
  refund_id     uuid [unique, not null, note: 'FK duy nhất -> refunds.id']
  status        varchar [not null, default: 'QUEUED', note: 'QUEUED / DISPATCHED / FAILED']
  dispatched_at timestamptz
  created_at    timestamptz [not null, default: `now()`]

  Indexes {
    refund_id
    status
  }
}

Table booking_service_failure_decisions {
  id                          uuid [pk]
  booking_id                  uuid [not null, note: 'FK -> bookings.id']
  payment_id                  uuid [not null, note: 'FK -> payments.id']
  command_id                  uuid [unique, not null, note: 'Lệnh idempotent phát sinh -> booking_commands.id']
  sequence_no                 bigint [not null]
  kind                        varchar(50) [not null, note: 'OWNER_CANCEL_BOOKING / OWNER_ACCEPT_STATION_FAILURE / ADMIN_REVIEW_STATION_FAILURE']
  result                      varchar(40) [not null, note: 'FULL_REFUND / NO_APPLIED_PAYMENT / INSUFFICIENT_EVIDENCE']
  actor_profile_id            uuid [not null, note: 'Chủ thể ra quyết định -> user_profile.id']
  actor_kind                  varchar(20) [not null, note: 'OWNER / ADMIN']
  actor_display_name_snapshot varchar(255) [not null]
  station_id                  uuid [not null, note: 'FK -> stations.id']
  owner_profile_id_snapshot   uuid [not null, note: 'Snapshot Owner -> user_profile.id']
  reason                      varchar(2000) [not null]
  affected_at                 timestamptz
  decided_at                  timestamptz [not null]
  policy_code                 varchar(100) [not null]
  policy_version              varchar(100) [not null]
  ticket_id                   uuid [note: 'Gắn case khiếu nại -> support_tickets.id']
  escalation_id               uuid [note: 'Gắn hồ sơ escalate -> ticket_escalations.id']
  source_receipt_id           uuid [note: 'Receipt nguồn -> payment_transactions.id']
  refund_id                   uuid [note: 'Nghĩa vụ hoàn phát sinh -> refunds.id']
  amount_vnd                  "numeric(19,2)" [not null]
  currency                    varchar(3) [not null, default: 'VND']
  evidence_snapshot           jsonb [not null, note: 'Ảnh chụp chứng cứ kỹ thuật append-only']

  Indexes {
    (booking_id, sequence_no)
    escalation_id
  }
}

// =====================================================================
// PHÂN HỆ 4: SUPPORT TICKET VÀ XỬ LÝ KHIẾU NẠI
// =====================================================================

Table support_tickets {
  id                  uuid [pk, default: `gen_random_uuid()`]
  ticket_code         varchar(32) [unique, not null, note: 'Mã ticket định dạng TKT-YYYYMMDD-XXXX']
  category            varchar(30) [not null, note: 'CHARGING_ISSUE / BOOKING / PAYMENT / ACCOUNT / OTHER']
  status              varchar(20) [not null, default: 'OPEN', note: 'OPEN / IN_PROGRESS / RESOLVED / CLOSED']
  priority            varchar(10) [not null, default: 'MEDIUM', note: 'LOW / MEDIUM / HIGH']
  reporter_id         uuid [not null, note: 'Người tạo yêu cầu -> user_profile.id']
  assigned_handler_id uuid [note: 'Người đang xử lý -> user_profile.id']
  station_id          uuid [note: 'Trạm liên quan -> stations.id']
  booking_id          uuid [note: 'Đơn đặt chỗ liên quan -> bookings.id']
  subject             varchar(160) [not null]
  description         varchar(2000) [not null]
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null, default: `now()`]
  updated_at          timestamptz [not null, default: `now()`]
  created_by          uuid
  updated_by          uuid

  Indexes {
    ticket_code
    reporter_id
    (station_id, status)
    (assigned_handler_id, status)
    (category, status)
  }
}

Table ticket_messages {
  id                uuid [pk, default: `gen_random_uuid()`]
  ticket_id         uuid [not null, note: 'FK -> support_tickets.id']
  author_id         uuid [not null, note: 'Người gửi -> user_profile.id']
  author_kind       varchar(20) [not null, note: 'REPORTER / OWNER / STAFF / ADMIN']
  client_message_id varchar [note: 'Mã tin nhắn phía client chống gửi đúp']
  body              varchar(2000) [not null, note: 'Nội dung tin nhắn append-only']
  created_at        timestamptz [not null, default: `now()`]

  Indexes {
    (ticket_id, created_at)
  }
}

Table ticket_findings {
  id          uuid [pk, default: `gen_random_uuid()`]
  ticket_id   uuid [not null, note: 'FK -> support_tickets.id']
  booking_id  uuid [not null, note: 'FK -> bookings.id']
  conclusion  varchar(30) [not null, note: 'STATION_FAILURE / NOT_STATION_FAILURE']
  affected_at timestamptz [not null]
  reason      varchar(2000) [not null]
  recorded_at timestamptz [not null, default: `now()`]
  recorded_by uuid [not null, note: 'Nhân viên / Chủ trạm ghi nhận -> user_profile.id']

  Indexes {
    ticket_id
    booking_id
  }
}

Table ticket_events {
  id         uuid [pk, default: `gen_random_uuid()`]
  ticket_id  uuid [not null, note: 'FK -> support_tickets.id']
  actor_id   uuid [not null, note: 'Người tác động -> user_profile.id']
  event_type varchar(50) [not null, note: 'CLAIMED / ASSIGNED / RESOLVED / AUTO_CLOSED_NO_RESPONSE / RETURN_TO_STATION / ...']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    ticket_id
    event_type
  }
}

Table ticket_escalations {
  id           uuid [pk, default: `gen_random_uuid()`]
  ticket_id    uuid [unique, not null, note: 'Case được leo thang lên Admin -> support_tickets.id']
  escalated_by uuid [not null, note: 'Người yêu cầu chuyển xét xử -> user_profile.id']
  reason       varchar(2000) [not null]
  status       varchar(30) [not null, default: 'PENDING_REVIEW', note: 'PENDING_REVIEW / UNDER_REVIEW / REVIEWED / REJECTED']
  reviewed_by  uuid [note: 'Admin xét duyệt -> user_profile.id']
  review_notes varchar(2000)
  escalated_at timestamptz [not null, default: `now()`]
  reviewed_at  timestamptz

  Indexes {
    ticket_id
    status
  }
}

Table app_notifications {
  id         uuid [pk, default: `gen_random_uuid()`]
  user_id    uuid [not null, note: 'Người nhận -> user_profile.id']
  type       varchar [not null, note: 'BOOKING / TICKET / REFUND / LICENSE']
  title      varchar [not null]
  body       text [not null]
  ref_type   varchar
  ref_id     uuid
  is_read    boolean [not null, default: false]
  read_at    timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, is_read, created_at)
  }
}

// =====================================================================
// PHỤ LỤC: BẢNG AUDIT LOG, COMMANDS, SỰ CỐ VÀ CẤU HÌNH HỆ THỐNG
// =====================================================================

Table booking_commands {
  id           uuid [pk, default: `gen_random_uuid()`]
  actor_id     uuid [not null, note: 'FK -> user_profile.id']
  operation    varchar(30) [not null]
  request_key  uuid [not null]
  payload_hash varchar(64) [not null]
  booking_id   uuid [not null, note: 'FK -> bookings.id']
  created_at   timestamptz [not null, default: `now()`]

  Indexes {
    (actor_id, operation, request_key)
    booking_id
  }
}

Table booking_status_history {
  id          uuid [pk, default: `gen_random_uuid()`]
  booking_id  uuid [not null, note: 'FK -> bookings.id']
  from_status varchar(30)
  to_status   varchar(30) [not null]
  actor_type  varchar(20) [not null]
  actor_id    uuid [note: 'FK -> user_profile.id']
  reason      varchar(500)
  created_at  timestamptz [not null, default: `now()`]

  Indexes {
    booking_id
  }
}

Table station_status_history {
  id          uuid [pk, default: `gen_random_uuid()`]
  station_id  uuid [not null, note: 'FK -> stations.id']
  from_status varchar(30)
  to_status   varchar(30) [not null]
  changed_by  uuid [note: 'FK -> user_profile.id']
  reason      varchar(500)
  changed_at  timestamptz [not null, default: `now()`]

  Indexes {
    station_id
  }
}

Table equipment_status_history {
  id             uuid [pk, default: `gen_random_uuid()`]
  equipment_type varchar(20) [not null, note: 'CHARGE_POINT / CONNECTOR']
  equipment_id   uuid [not null]
  from_status    varchar(30)
  to_status      varchar(30) [not null]
  actor_type     varchar(20) [not null, note: 'SYSTEM / ADMIN / OWNER / STAFF']
  actor_id       uuid [note: 'FK -> user_profile.id']
  reason         varchar(500)
  changed_at     timestamptz [not null, default: `now()`]

  Indexes {
    (equipment_type, equipment_id)
  }
}

Table license_status_events {
  id           uuid [pk, default: `gen_random_uuid()`]
  license_id   uuid [not null, note: 'FK -> licenses.id']
  event_type   varchar(30) [not null]
  from_status  varchar(30)
  to_status    varchar(30) [not null]
  reason       varchar(500)
  actor_type   varchar(20) [not null]
  performed_by uuid [note: 'FK -> user_profile.id']
  performed_at timestamptz [not null, default: `now()`]

  Indexes {
    license_id
  }
}

Table connector_incidents {
  id                      uuid [pk, default: `gen_random_uuid()`]
  connector_id            uuid [not null, note: 'FK -> connectors.id']
  status                  varchar(20) [not null, note: 'OPEN / RECOVERED']
  reason                  varchar(2000) [not null]
  occurred_at             timestamptz [not null]
  reported_at             timestamptz [not null]
  reported_by             uuid [not null, note: 'FK -> user_profile.id']
  actor_type              varchar(20) [not null]
  previous_runtime_status varchar(30) [not null]
  recovered_at            timestamptz
  recovered_by            uuid [note: 'FK -> user_profile.id']
  recovery_actor_type     varchar(20)
  recovery_reason         varchar(2000)
  version                 bigint [not null, default: 0]

  Indexes {
    connector_id
    status
  }
}

Table incident_bookings {
  id               uuid [pk, default: `gen_random_uuid()`]
  incident_id      uuid [not null, note: 'FK -> connector_incidents.id']
  booking_id       uuid [not null, note: 'FK -> bookings.id']
  snapshot_status  varchar(30) [not null]
  snapshot_version bigint [not null]
  state            varchar(30) [not null, note: 'AWAITING_SESSION_STOP / NO_ACTIVE_SESSION / SESSION_RESOLVED']
  resolved_at      timestamptz
  resolved_by      uuid [note: 'FK -> user_profile.id']
  resolution_reason varchar(2000)

  Indexes {
    incident_id
    booking_id
  }
}

Table system_configs {
  id           uuid [pk, default: `gen_random_uuid()`]
  config_key   varchar [unique, not null]
  config_value varchar [not null]
  value_type   varchar [note: 'STRING / NUMBER / BOOLEAN']
  description  varchar
  updated_at   timestamptz [not null, default: `now()`]
  updated_by   uuid
}

Table legal_documents {
  id             uuid [pk, default: `gen_random_uuid()`]
  slug           varchar(100) [unique, not null]
  doc_type       varchar(50) [not null, note: 'TERMS_OF_SERVICE / PRIVACY_POLICY / LICENSE_AGREEMENT / OPERATIONAL_REGULATION']
  target_audience varchar(30) [not null, default: 'ALL', note: 'ALL / DRIVER / OWNER']
  title          varchar(255) [not null]
  eyebrow        varchar(100)
  summary        text
  content        text [not null]
  version        varchar(30) [not null, default: '1.0.0']
  locale         varchar(10) [not null, default: 'vi']
  keywords       text[] [not null, default: '{}']
  is_active      boolean [not null, default: true]
  effective_from timestamptz [not null, default: `now()`]
  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]
  created_by     uuid
  updated_by     uuid
  deleted_at     timestamptz
}

// =====================================================================
// TABLE GROUPS THEO 4 PHÂN HỆ NGHIỆP VỤ BÁO CÁO
// =====================================================================

TableGroup Subsystem_1_User_Station_Device_License {
  user_profile
  stations
  station_assets
  station_staff_assignments
  station_staff_invitations
  charge_points
  connectors
  licenses
}

TableGroup Subsystem_2_Booking_Schedule_Pricing {
  bookings
  booking_price_lines
  station_operating_schedules
  station_operating_periods
  station_booking_settings
  tou_rates
}

TableGroup Subsystem_3_Payment_Refund_Decision {
  payments
  payment_transactions
  refunds
  refund_attempts
  refund_auto_dispatches
  booking_service_failure_decisions
}

TableGroup Subsystem_4_Support_Dispute {
  support_tickets
  ticket_messages
  ticket_findings
  ticket_events
  ticket_escalations
  app_notifications
}

TableGroup Appendix_Audit_And_Operations {
  booking_commands
  booking_status_history
  station_status_history
  equipment_status_history
  license_status_events
  connector_incidents
  incident_bookings
  system_configs
  legal_documents
}

// =====================================================================
// QUAN HỆ KHÓA NGOẠI (RELATIONSHIPS)
// =====================================================================

// Phân hệ 1
Ref: stations.owner_id > user_profile.id
Ref: station_assets.station_id > stations.id
Ref: station_staff_assignments.station_id > stations.id
Ref: station_staff_assignments.staff_id > user_profile.id
Ref: station_staff_assignments.assigned_by > user_profile.id
Ref: station_staff_invitations.station_id > stations.id
Ref: station_staff_invitations.invited_by > user_profile.id
Ref: charge_points.station_id > stations.id
Ref: connectors.charge_point_id > charge_points.id
Ref: licenses.station_id > stations.id
Ref: licenses.owner_id > user_profile.id
Ref: licenses.renewed_from_license_id > licenses.id

// Phân hệ 2
Ref: station_operating_schedules.station_id > stations.id
Ref: station_operating_periods.schedule_id > station_operating_schedules.id
Ref: station_booking_settings.station_id > stations.id
Ref: tou_rates.station_id > stations.id
Ref: bookings.driver_id > user_profile.id
Ref: bookings.connector_id > connectors.id
Ref: bookings.financial_owner_id > user_profile.id
Ref: booking_price_lines.booking_id > bookings.id

// Phân hệ 3
Ref: payments.booking_id > bookings.id
Ref: payment_transactions.payment_id > payments.id
Ref: refunds.booking_id > bookings.id
Ref: refunds.payment_id - payments.id
Ref: refund_attempts.refund_id > refunds.id
Ref: refund_attempts.actor_id > user_profile.id
Ref: refund_auto_dispatches.refund_id - refunds.id
Ref: booking_service_failure_decisions.booking_id > bookings.id
Ref: booking_service_failure_decisions.payment_id > payments.id
Ref: booking_service_failure_decisions.command_id - booking_commands.id
Ref: booking_service_failure_decisions.actor_profile_id > user_profile.id
Ref: booking_service_failure_decisions.station_id > stations.id
Ref: booking_service_failure_decisions.ticket_id > support_tickets.id
Ref: booking_service_failure_decisions.escalation_id > ticket_escalations.id
Ref: booking_service_failure_decisions.source_receipt_id > payment_transactions.id
Ref: booking_service_failure_decisions.refund_id > refunds.id

// Phân hệ 4
Ref: support_tickets.reporter_id > user_profile.id
Ref: support_tickets.assigned_handler_id > user_profile.id
Ref: support_tickets.station_id > stations.id
Ref: support_tickets.booking_id > bookings.id
Ref: ticket_messages.ticket_id > support_tickets.id
Ref: ticket_messages.author_id > user_profile.id
Ref: ticket_findings.ticket_id > support_tickets.id
Ref: ticket_findings.booking_id > bookings.id
Ref: ticket_findings.recorded_by > user_profile.id
Ref: ticket_events.ticket_id > support_tickets.id
Ref: ticket_events.actor_id > user_profile.id
Ref: ticket_escalations.ticket_id - support_tickets.id
Ref: ticket_escalations.escalated_by > user_profile.id
Ref: ticket_escalations.reviewed_by > user_profile.id
Ref: app_notifications.user_id > user_profile.id

// Phụ lục / Audit
Ref: booking_commands.actor_id > user_profile.id
Ref: booking_commands.booking_id > bookings.id
Ref: booking_status_history.booking_id > bookings.id
Ref: booking_status_history.actor_id > user_profile.id
Ref: station_status_history.station_id > stations.id
Ref: station_status_history.changed_by > user_profile.id
Ref: license_status_events.license_id > licenses.id
Ref: license_status_events.performed_by > user_profile.id
Ref: connector_incidents.connector_id > connectors.id
Ref: connector_incidents.reported_by > user_profile.id
Ref: connector_incidents.recovered_by > user_profile.id
Ref: incident_bookings.incident_id > connector_incidents.id
Ref: incident_bookings.booking_id > bookings.id
