meta {
  name: Get Booking Detail
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/bookings/{{bookingId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

script:post-response {
  if (res.status === 200 && res.body.data) {
    bru.setEnvVar("bookingVersion", String(res.body.data.version));
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Detail matches created booking", function() {
    const d = res.getBody().data;
    expect(d.bookingId).to.equal(bru.getEnvVar("bookingId"));
    expect(d.bookingCode).to.be.a("string");
    expect(d.durationMin).to.equal(60);
  });
  test("Booking is CONFIRMED after successful payment", function() {
    const d = res.getBody().data;
    expect(d.status).to.equal("CONFIRMED");
    expect(d.persistedStatus).to.equal("CONFIRMED");
    expect(d.paymentConfirmedAt).to.be.a("string");
    expect(d.payment.status).to.equal("PAID");
  });
  test("Detail carries pricing and scheduling facts", function() {
    const d = res.getBody().data;
    expect(String(d.totalAmount)).to.equal(bru.getEnvVar("bookingTotal"));
    expect(new Date(d.startAt).toISOString()).to.equal(bru.getEnvVar("startTime"));
    expect(d.checkInDeadline).to.be.a("string");
    expect(d.actions).to.be.an("object");
  });
  test("version captured for cancel consent", function() {
    expect(bru.getEnvVar("bookingVersion")).to.match(/^\d+$/);
  });
}
