meta {
  name: Get My Booking History
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/bookings/history?query=&status=ALL&page=1&size=20
  body: none
  auth: bearer
}

params:query {
  query:
  status: ALL
  page: 1
  size: 20
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Booking history returned with pagination", function() {
    expect(res.getBody().data).to.be.an("array");
    expect(res.getBody().meta.totalElements).to.be.a("number");
  });
  test("Cancelled booking appears in history", function() {
    const rows = res.getBody().data || [];
    const found = rows.filter(function(b) {
      return b.bookingId === bru.getEnvVar("bookingId");
    });
    expect(found).to.have.length(1);
    expect(found[0].status).to.equal("CANCELLED");
  });
}
