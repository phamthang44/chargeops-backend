meta {
  name: Get My Active Bookings
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/bookings/active?page=1&size=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  size: 20
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Active bookings returned with pagination", function() {
    expect(res.getBody().data).to.be.an("array");
    expect(res.getBody().meta.totalElements).to.be.a("number");
  });
  test("Cancelled booking is no longer active", function() {
    const active = res.getBody().data || [];
    const found = active.filter(function(b) {
      return b.bookingId === bru.getEnvVar("bookingId");
    });
    expect(found).to.have.length(0);
  });
}
