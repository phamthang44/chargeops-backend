meta {
  name: Get My Booking History
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/bookings/history?query=&status=ALL&page=1&size=20
  body: none
  auth: bearer
}

params:query {
  query:
  status: ALL
  page: 1
  size: 20
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Booking history returned", function() {
    expect(res.getBody().data).to.be.an('array');
  });
}
