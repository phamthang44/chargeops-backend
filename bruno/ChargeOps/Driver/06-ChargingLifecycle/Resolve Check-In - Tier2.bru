meta {
  name: Resolve Check-In - Tier2
  type: http
  seq: 9
}

tags {
  tier2Post
}

post {
  url: {{baseUrl}}/api/v1/bookings/check-in/resolve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "bookingId": "{{bookingId}}",
    "challengeToken": "{{challengeToken}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body.data) {
    bru.setEnvVar("bookingVersion", String(res.body.data.expectedVersion));
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Resolved challenge binds booking and connector", function() {
    const d = res.getBody().data;
    expect(d.bookingId).to.equal(bru.getEnvVar("bookingId"));
    expect(d.connectorId).to.equal(bru.getEnvVar("connectorId"));
    expect(d.connectorCode).to.be.a("string");
    expect(d.startAt).to.be.a("string");
    expect(d.checkInDeadline).to.be.a("string");
  });
  test("expectedVersion captured for confirm", function() {
    expect(bru.getEnvVar("bookingVersion")).to.match(/^\d+$/);
  });
}
