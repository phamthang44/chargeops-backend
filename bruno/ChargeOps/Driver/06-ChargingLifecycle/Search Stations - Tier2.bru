meta {
  name: Search Stations - Tier2
  type: http
  seq: 2
}

tags {
  tier2Pre
}

get {
  url: {{baseUrl}}/api/v1/stations?page=1&size=12
  body: none
  auth: none
}

params:query {
  page: 1
  size: 12
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.length > 0) {
    bru.setEnvVar("stationId", res.body.data[0].id);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("stationId captured", function() {
    expect(bru.getEnvVar("stationId")).to.be.a("string");
  });
}
