meta {
  name: Search Stations
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/stations?page=1&size=12
  body: none
  auth: none
}

params:query {
  page: 1
  size: 12
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.length > 0) {
    bru.setEnvVar("stationId", res.body.data[0].id);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response has success true", function() {
    expect(res.getBody().success).to.equal(true);
  });
  test("Stations array returned", function() {
    expect(res.getBody().data).to.be.an('array');
  });
}
