meta {
  name: Search Stations
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/stations?page=1&size=12
  body: none
  auth: none
}

params:query {
  page: 1
  size: 12
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.length > 0) {
    bru.setEnvVar("stationId", res.body.data[0].id);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Envelope has data array and pagination meta", function() {
    expect(res.getBody().data).to.be.an("array").that.is.not.empty;
    expect(res.getBody().meta.totalElements).to.be.a("number");
  });
  test("Each station carries id, name and coordinates", function() {
    res.getBody().data.forEach(function(s) {
      expect(s.id).to.be.a("string");
      expect(s.name).to.be.a("string");
      expect(s).to.have.property("latitude");
      expect(s).to.have.property("longitude");
    });
  });
  test("stationId captured for detail/availability", function() {
    expect(bru.getEnvVar("stationId")).to.be.a("string");
  });
}
