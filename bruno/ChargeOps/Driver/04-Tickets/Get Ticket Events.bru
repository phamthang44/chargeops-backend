meta {
  name: Get Ticket Events
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/tickets/{{ticketId}}/events?page=1&size=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  size: 20
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Events returned as array", function() {
    expect(res.getBody().data).to.be.an("array");
  });
}
