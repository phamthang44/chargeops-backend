logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "chargeops_backend" {
  path_targets = [{
    "__path__"     = "/var/log/chargeops/chargeops-app.log",
    "job"          = "chargeops-backend",
    "service_name" = "chargeops",
    "environment"  = "dev",
  }]
}

loki.source.file "chargeops_backend" {
  targets       = local.file_match.chargeops_backend.targets
  forward_to    = [loki.process.chargeops_backend.receiver]
  tail_from_end = true
}

loki.process "chargeops_backend" {
  stage.regex {
    expression = `^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2} \[[^]]+\] (?P<level>TRACE|DEBUG|INFO|WARN|ERROR)\s+.*$`
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
